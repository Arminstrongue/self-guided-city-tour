# URL pública da app (sem barra final)
APP_URL=http://localhost:3000

# Base de dados: PostgreSQL em produção; "pglite:./.data/db" para desenvolvimento sem servidor
DATABASE_URL=pglite:./.data/db

# Segredo para assinar cookies de acesso e sessões (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET=troque-isto
NEXTAUTH_URL=http://localhost:3000

# Stripe (modo de teste: chaves sk_test_ / whsec_)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Login social (deixe vazio para desativar o fornecedor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Emails com acesso ao painel de administração, separados por vírgulas
ADMIN_EMAILS=admin@selfguidedcitytour.com
# Só no seu computador: abre o painel /pt/admin sem login social (ignorado em produção)
DEV_ADMIN=1
POSTGRES_PASSWORD=troque-isto
DOMAIN=selfguidedcitytour.com

# Dados da empresa (aparecem nos termos e na política de privacidade)
COMPANY_NAME=
COMPANY_NIPC=
COMPANY_ADDRESS=
COMPANY_EMAIL=hello@selfguidedcitytour.com

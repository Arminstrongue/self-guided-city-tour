# URL pública da app (sem barra final)
APP_URL=http://localhost:3000
# Em produção: APP_URL=https://hellotravell.com

# Base de dados: PostgreSQL em produção; "pglite:./.data/db" para desenvolvimento sem servidor
DATABASE_URL=pglite:./.data/db

# Segredo para assinar cookies de acesso e sessões (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET=troque-isto
NEXTAUTH_URL=http://localhost:3000

# Stripe (modo de teste: chaves sk_test_ / whsec_)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Login social (deixe vazio para desativar o fornecedor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Entrar com a Apple (ver deploy/SIGN-IN.md): APPLE_ID = Services ID; o segredo é gerado e renovado a partir da chave .p8.
APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# (alternativa antiga: APPLE_SECRET=<JWT gerado à mão, expira em 6 meses>)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Emails com acesso ao painel de administração, separados por vírgulas
ADMIN_EMAILS=admin@hellotravell.com
# Só no seu computador: abre o painel /pt/admin sem login social (ignorado em produção)
DEV_ADMIN=1
POSTGRES_PASSWORD=troque-isto
DOMAIN=hellotravell.com

# Dados da empresa (aparecem nos termos e na política de privacidade)
COMPANY_NAME=
COMPANY_NIPC=
COMPANY_ADDRESS=
COMPANY_EMAIL=hello@hellotravell.com

# Estado do voo em direto (opcional): chave AeroDataBox na RapidAPI. Sem chave, a funcionalidade fica escondida.
AERODATABOX_API_KEY=
# Restaurantes perto de cada paragem com as melhores avaliações e preço baixo (Google Places API New, "Places API (New)" ativa)
GOOGLE_PLACES_API_KEY=
# Pôr a 1 quando a ETIAS começar a ser exigida (prevista para o 4.º trimestre de 2026).
NEXT_PUBLIC_ETIAS_LIVE=0

# Mapas (OpenStreetMap por defeito). Com muitos utilizadores, use um fornecedor de mosaicos — ver SCALING.md.
# Lidos em tempo de execução (não é preciso reconstruir). Ex.: MapTiler
#   MAP_TILES=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=SUA_CHAVE
#   MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
# MAP_TILES_PREFETCH=1 deixa o viajante descarregar o mapa da cidade para usar sem internet
# (só se o plano do fornecedor o permitir; nunca com o OpenStreetMap público).
MAP_TILES=
MAP_ATTRIBUTION=
MAP_TILES_PREFETCH=0
# Ligações à base de dados por réplica da app.
DB_POOL_MAX=10

# Emails (Resend)
RESEND_API_KEY=
EMAIL_FROM=HelloTravell <hello@hellotravell.com>
EMAIL_REPLY_TO=hello@hellotravell.com

# Eventos por cidade (gratuito: developer.ticketmaster.com → My Apps → Consumer Key)
TICKETMASTER_API_KEY=
# Cidades com roteiro gratuito (demonstração), separadas por vírgulas
FREE_CITIES=man
# Google Maps no navegador (mapa e Street View em "Explorar"). Chave restrita por site (HTTP referrer) a hellotravell.com/*,
# só com "Maps JavaScript API". A GOOGLE_PLACES_API_KEY (servidor, restrita ao IP) serve os lugares, fotos e avaliações.
GOOGLE_MAPS_BROWSER_KEY=
# Teto diário de pedidos pagos ao Google (controlado pela app). Ao chegar ao teto usa OpenStreetMap/Wikimedia até ao dia seguinte.
GOOGLE_MAX_SEARCH_PER_DAY=300
GOOGLE_MAX_PHOTOS_PER_DAY=500

# Notificações push no telemóvel (Web Push). Gerar uma vez no servidor:
#   docker compose run --rm --no-deps migrate node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\nVAPID_PRIVATE_KEY='+k.privateKey)"
# A chave privada fica só no .env do servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@hellotravell.com

# Cópias de segurança (deploy/backup.sh --install; ver deploy/RESTORE.md)
BACKUP_TARGET=
BACKUP_KEEP_DAYS=30

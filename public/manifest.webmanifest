{
  "id": "/",
  "name": "Self Guided City Tour",
  "short_name": "City Tour",
  "description": "Self-guided city routes for layovers and short trips, with transport, safety tips and a countdown to your flight.",
  "start_url": "/wallet?src=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["travel", "navigation", "social"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "New post", "short_name": "Post", "url": "/wallet#compose", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Search", "short_name": "Search", "url": "/wallet#search", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Messages", "short_name": "Chat", "url": "/wallet#chat", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Travel tools", "short_name": "Tools", "url": "/wallet#tools", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/api/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}

{
  "id": "/",
  "name": "VOYBU",
  "short_name": "VOYBU",
  "description": "VOYBU — your self-guided tour. City routes with an audio guide, transport, safety and your trip essentials in one place.",
  "start_url": "/wallet?src=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#000000",

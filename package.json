{
  "name": "self-guided-city-tour",
  "version": "0.1.0",
  "private": true,
  "description": "Self Guided City Tour — roteiros autoguiados para passageiros em escala",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "mobile:sync": "cap sync",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android",
    "mobile:icons": "npx @capacitor/assets@3.0.5 generate"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.4",
    "@electric-sql/pglite": "0.2.17",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/bricolage-grotesque": "5.2.10",
    "@fontsource/figtree": "5.2.10",
    "drizzle-orm": "0.45.4",
    "leaflet": "^1.9.4",
    "next": "14.2.35",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "17.7.0",
    "web-push": "3.6.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/leaflet": "^1.9.12",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}

{$DOMAIN} {
	# Sem compressão no tempo real (SSE), para os eventos saírem logo.
	@compress not path /api/live
	encode @compress zstd gzip
	# Várias réplicas da app: o Caddy descobre-as por DNS e distribui os pedidos.
	reverse_proxy {
		dynamic a app 3000
		lb_policy least_conn
		health_uri /api/health
		health_interval 15s
	}
	# Ficheiros estáticos com cache longa (a Cloudflare guarda-os na rede dela).
	@static path /_next/static/* /icon-* /apple-touch-icon.png /music/*
	header @static Cache-Control "public, max-age=31536000, immutable"
}

# www → domínio principal
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

